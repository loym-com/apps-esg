<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="property_code.PropertyDefinition" t-inherit="web.PropertyDefinition" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_modal_container')]/div[1]" position="after">
            <div t-if="state.propertyDefinition.type !== 'separator'" class="d-contents mb-3 mb-sm-0">
                <label class="o_form_label align-self-center text-900">Code</label>
                <h6 t-if="props.readonly" t-out="state.propertyDefinition.code" class="text-truncate"/>
                <input
                    t-else=""
                    class="o_input"
                    type="text"
                    placeholder="prop1"
                    autocomplete="off"
                    t-model="state.propertyDefinition.code"
                    t-on-change="onPropertyCodeChange"
                />
            </div>
        </xpath>
    </t>
</templates>
