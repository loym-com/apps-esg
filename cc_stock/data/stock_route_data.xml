<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="route_cc_mint" model="stock.route">
            <field name="name">CC Mint</field>
            <field name="sequence">20</field>
            <field name="company_id"></field>
            <field name="sale_selectable" eval="True"/>
            <field name="product_selectable" eval="True"/>
            <field name="product_categ_selectable" eval="True"/>
        </record>
        <record id="rule_cc_mint" model="stock.rule">
            <field name="name">CC Mint: Vendor → Customer</field>
            <field name="action">buy</field>
            <field name="location_dest_id" ref="stock.stock_location_customers"/>
            <field name="location_src_id" ref="stock.stock_location_suppliers"/>
            <field name="procure_method">make_to_order</field>
            <field name="route_id" ref="route_cc_mint"/>
            <field name="picking_type_id" ref="stock_picking_type_cc_mint"/>
        </record>
    </data>
</odoo>
