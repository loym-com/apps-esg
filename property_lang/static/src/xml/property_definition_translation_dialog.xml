<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="property_lang.PropertyDefinitionTranslationDialog">
        <Dialog title="title">
            <div class="o_translation_dialog">
                <t t-foreach="terms" t-as="term" t-key="term.id">
                    <div class="row">
                        <div
                            class="col-12 col-lg-3"
                            t-att-class="{ o_language_current: term.lang === user.lang }"
                        >
                            <t t-esc="term.langName" />
                        </div>
                        <div class="col-12 col-lg-9 translation">
                            <input
                                type="text"
                                class="o_field_char o_input"
                                t-att-value="updatedTerms[term.id]"
                                t-on-change="(ev) => this.updatedTerms[term.id] = ev.target.value"
                            />
                        </div>
                    </div>
                </t>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-primary" t-on-click="onSaveDialog">Save</button>
                <button class="btn" t-on-click="props.close">Discard</button>
            </t>
        </Dialog>
    </t>
</templates>
