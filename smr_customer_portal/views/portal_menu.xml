<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_dashboard"
              name="Portal: Dashboard Card"
              inherit_id="portal.portal_my_home"
              customize_show="True"
              priority="30">

        <!-- Target the portal_common_category div (Addresses + Security) -->
        <xpath expr="//div[@id='portal_common_category']" position="after">
            <div class="o_portal_category row g-2 mt-3">
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/dashboard#dashboard"
                       title="My Dashboard"
                       class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="o_portal_icon d-block align-self-start">
                            <i class="fa fa-tachometer fa-2x" role="img"/>
                        </div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                                <span>Customer Portal</span>
                            </div>
                            <div class="opacity-75">
                                View your Customer Portal 
                            </div>
                        </div>
                    </a>
                </div>
                <div class="o_portal_index_card col-md-6 order-2">
                    <a href="/my/dashboard#inventory"
                       title="Inventory Management"
                       class="d-flex gap-2 gap-md-3 py-3 pe-2 px-md-3 h-100 rounded text-decoration-none bg-100">
                        <div class="o_portal_icon d-block align-self-start">
                            <i class="fa fa-cubes fa-2x" role="img"/>
                        </div>
                        <div>
                            <div class="mt-0 mb-1 fs-5 fw-normal lh-1 d-flex gap-2">
                                <span>Inventory Management</span>
                            </div>
                            <div class="opacity-75">
                                View your Inventory Management 
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        </xpath>

    </template>
</odoo>