<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <data>
                <field name="categ_id" position="attributes">
                    <attribute name="readonly">category_lock</attribute>
                </field>
                <field name="product_properties" position="replace"/>
                <notebook position="inside">
                    <page string="Properties" name="properties_page">
                        <group>
                            <field name="category_lock" widget="boolean_toggle"/>
                            <field name="categ_id" string="Category" readonly="category_lock"/>
                        </group>
                        <field name="product_properties" widget="properties" editMode="1" columns="1"/>
                    </page>
                </notebook>
            </data>
        </field>
    </record>
</odoo>
